# Cloudflare Pages _headers configuration (Updated: 2026-11-18)
# Unencumbered crawling, indexing, edge caching, and modern baseline headers

# Global baseline headers for all routes (no restrictive frame or crawler blocks)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Access-Control-Allow-Origin: *

# HTML Pages: immediate revalidation to ensure fresh content & timestamps
/
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://fadhil.dev/>; rel="canonical"
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://fadhil.dev/>; rel="canonical"

# 404 Error page: Strictly noindex and fresh validation
/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow
/404
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow

# Unhashed application CSS & JS modules: fast edge cache with background revalidation (never immutable)
/app/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Static image & icon assets: 1-year immutable global edge delivery & full image indexing
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: all
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Search Engine Optimization & PWA Manifest files
/site.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8

# Progressive Web App (PWA) Service Worker (placed last so no rule overrides it)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8
