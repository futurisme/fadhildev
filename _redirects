/fadhil/assets/* /assets/:splat 200
/fadhil/favicon.svg /favicon.svg 200
/fadhil/favicon.ico /favicon.ico 200
/fadhil/apple-touch-icon.png /apple-touch-icon.png 200
/fadhil/site.webmanifest /site.webmanifest 200
/fadhil/fadhil-512x512.png /fadhil-512x512.png 200
/fadhil/fadhil.svg /fadhil.svg 200

